# Copy this file to .env and fill in your keys. Never commit .env itself.

# Which LLM to use for generation: "mistral" or "anthropic"
LLM_PROVIDER=mistral

# Required if LLM_PROVIDER=mistral. Get one free at https://console.mistral.ai
# (the "Experiment" tier is rate-limited but free — fine for this project's
# usage volume).
MISTRAL_API_KEY=

# Required if LLM_PROVIDER=anthropic. Pay-as-you-go, no ongoing free tier.
ANTHROPIC_API_KEY=

# Only needed if you go with OpenAI or Voyage embeddings instead of local
# sentence-transformers.
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
